<form class="form-horizontal">
    <div class="control-group-header">
        <h3>GPIO Status</h3>
    </div>

    <div class="control-group">
        This screen has been moved <a href="/#tab_plugin_gpiostatus">here</a>
        (exit from this window after clicking).
    </div>

    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox"
                       data-bind="checked: gpiostatus.reload_on_check_change">
                {{ _("Reload completely the data whenever a checkbox state is changed") }}
            </label>
        </div>
    </div>

    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox"
                       data-bind="checked: gpiostatus.load_on_startup">
                {{ _("Load the GPIO Status when the web page is open") }}
            </label>
        </div>
    </div>

    <div class="control-group-header">
        <h4>{{ _("Advanced") }}</h4>
    </div>

    <div class="control-group">
        <label class="control-label">{{ _("GPIO tool") }}</label>
        <div class="controls">
            <select data-bind="value: gpiostatus.gpio_tool">
                <option value="auto">{{ _("Auto (raspi-gpio, then pinctrl)") }}</option>
                <option value="raspi-gpio">raspi-gpio</option>
                <option value="pinctrl">pinctrl</option>
            </select>
            <button class="btn" data-bind="click: function() { tool_check.run(); },
                                           disable: tool_check.checking() || gpiostatus.gpio_tool() === 'auto'">
                <span data-bind="visible: !tool_check.checking()">{{ _("Check") }}</span>
                <span data-bind="visible: tool_check.checking()">{{ _("Checking...") }}</span>
            </button>
            <div data-bind="visible: tool_check.success() !== null" style="margin-top: 5px">
                <span data-bind="text: tool_check.message,
                                 css: {'text-success': tool_check.success(),
                                       'text-error': tool_check.success() === false}"></span>
            </div>
        </div>
    </div>
</form>